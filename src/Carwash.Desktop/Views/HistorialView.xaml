<UserControl x:Class="Carwash.Desktop.Views.HistorialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="#FAFBFC">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FAFBFC">
  <StackPanel Margin="24,8,24,24" Background="#FAFBFC">
    <TextBlock Text="Comprobantes" FontSize="26" FontWeight="Bold" Foreground="Black" Margin="0,0,0,16"/>

    <ui:Card Margin="0,0,0,16" Background="White" BorderBrush="#E5E5E5" BorderThickness="1" Padding="20">
      <StackPanel>
        <TextBlock Text="Buscar Factura / Cliente" FontSize="16" FontWeight="Bold" Foreground="Black"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <TextBox Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" MinWidth="420" ToolTip="Buscar factura, cliente..."/>
          <ui:Button Content="Actualizar" Command="{Binding RecargarCmd}" Margin="10,0,0,0" Padding="16,8" Icon="{ui:SymbolIcon ArrowSync24}"/>
        </StackPanel>
      </StackPanel>
    </ui:Card>

    <ui:Card Background="White" BorderBrush="#E5E5E5" BorderThickness="1" Padding="20" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="Registro de Comprobantes Emitidos" FontSize="16" FontWeight="Bold" Foreground="Black"/>
        <TextBlock Text="Visualiza facturas, cobros y comprobantes térmicos." Foreground="Gray" FontSize="12" Margin="0,2,0,12"/>
        <DataGrid ItemsSource="{Binding Vista}" SelectedItem="{Binding Seleccionado, Mode=TwoWay}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" CanUserResizeRows="False"
                  IsReadOnly="True" SelectionMode="Single" MinHeight="180"
                  GridLinesVisibility="None" Background="White" BorderThickness="0">
          <DataGrid.ColumnHeaderStyle>
            <Style TargetType="DataGridColumnHeader">
              <Setter Property="Foreground" Value="Gray"/>
              <Setter Property="FontSize" Value="11"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="Background" Value="#F7F8FA"/>
              <Setter Property="Padding" Value="8,8"/>
            </Style>
          </DataGrid.ColumnHeaderStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Nº FACTURA" Binding="{Binding Folio}" Width="110"/>
            <DataGridTextColumn Header="CLIENTE" Binding="{Binding Cliente}" Width="*"/>
            <DataGridTextColumn Header="LAVADOR" Binding="{Binding Lavador}" Width="120"/>
            <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy hh:mm tt}" Width="150"/>
            <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat={}RD\${0:N2}}" Width="110"/>
            <DataGridTextColumn Header="ABONO COBRADO" Binding="{Binding Abono, StringFormat={}RD\${0:N2}}" Width="130"/>
            <DataGridTextColumn Header="SALDO PENDIENTE" Binding="{Binding Saldo, StringFormat={}RD\${0:N2}}" Width="140"/>
            <DataGridTemplateColumn Header="ESTADO" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#E6F4EA"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Estado}" Value="P">
                            <Setter Property="Background" Value="#FEF3E2"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Estado}" Value="A">
                            <Setter Property="Background" Value="#FDECEA"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding EstadoTexto}" FontSize="11" FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="#137333"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Estado}" Value="P">
                              <Setter Property="Foreground" Value="#B45309"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Estado}" Value="A">
                              <Setter Property="Foreground" Value="#B3261E"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="ACCIONES" Width="210">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="Ver" Padding="10,4" Margin="0,0,4,0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand"
                            Command="{Binding DataContext.VerCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    <Button Content="Ticket" Padding="10,4" Margin="0,0,4,0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand"
                            Command="{Binding DataContext.TicketFilaCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    <Button Content="Anular" Padding="10,4" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand"
                            Command="{Binding DataContext.AnularFilaCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding ConteoTexto}" Foreground="Gray" FontSize="12" Margin="0,10,0,0"/>
      </StackPanel>
    </ui:Card>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>
      <ui:Card Grid.Column="0" Background="White" BorderBrush="#E5E5E5" BorderThickness="1" Padding="20" Margin="0,0,8,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Qué se hizo (detalle)" FontSize="16" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding Detalle}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" CanUserResizeRows="False"
                    IsReadOnly="True" SelectionMode="Single" MinHeight="70" MaxHeight="180" Margin="0,8,0,0"
                    GridLinesVisibility="None" Background="White" BorderThickness="0" VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*"/>
              <DataGridTextColumn Header="Cant" Binding="{Binding Cantidad}" Width="60"/>
              <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=N2}" Width="90"/>
              <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=N2}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
            <TextBlock Text="Cobrar pendiente:" FontWeight="Bold" VerticalAlignment="Center" Foreground="Black"/>
            <ComboBox SelectedValue="{Binding PagoMetodo}" SelectedValuePath="Tag" Width="140" Margin="8,0,0,0">
              <ComboBoxItem Content="Efectivo" Tag="1" IsSelected="True"/>
              <ComboBoxItem Content="Transferencia" Tag="2"/>
            </ComboBox>
            <ui:Button Content="Marcar pagado" Command="{Binding PagarCmd}" Margin="8,0,0,0" Icon="{ui:SymbolIcon Checkmark24}"/>
          </StackPanel>
        </StackPanel>
      </ui:Card>
      <ui:Card Grid.Column="1" Background="White" BorderBrush="#E5E5E5" BorderThickness="1" Padding="20">
        <StackPanel>
          <TextBlock Text="Factura (así sale en Epson)" FontSize="16" FontWeight="Bold" Foreground="Black"/>
          <TextBox Text="{Binding FacturaTexto, Mode=OneWay}" FontFamily="Consolas" FontSize="11"
                   IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" MinHeight="220" Margin="0,8,0,0"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </StackPanel>
      </ui:Card>
    </Grid>
    <TextBlock Text="{Binding Mensaje}" Foreground="Green" Margin="4,8,0,0" FontSize="14"/>
  </StackPanel>
  </ScrollViewer>
</UserControl>
