<UserControl x:Class="Carwash.Desktop.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="#FAFBFC">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FAFBFC">
  <StackPanel Margin="24,8,24,24" Background="#FAFBFC">
    <TextBlock Text="Configuración" FontSize="26" FontWeight="Bold" Foreground="Black" Margin="0,0,0,16"/>
    <ui:Card Background="White" BorderBrush="#E5E5E5" BorderThickness="1" Padding="20" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="Negocio" FontSize="18" FontWeight="Bold" Foreground="Black"/>
        <StackPanel Margin="0,12,0,0">
          <TextBlock Text="Nombre" Foreground="Gray" FontSize="12"/>
          <ui:TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Margin="0,2,0,8"/>
          <TextBlock Text="Teléfono" Foreground="Gray" FontSize="12"/>
          <ui:TextBox Text="{Binding Telefono}" FontSize="15" Margin="0,2,0,8"/>
          <TextBlock Text="Dirección" Foreground="Gray" FontSize="12"/>
          <ui:TextBox Text="{Binding Direccion}" FontSize="15" Margin="0,2,0,12"/>
          <ui:Button Content="Guardar negocio" Command="{Binding GuardarCmd}" Appearance="Secondary" HorizontalAlignment="Left" Icon="{ui:SymbolIcon Save24}"/>
        </StackPanel>
        <TextBlock Text="Impresora: EPSON TM-T20II (80mm)" Margin="0,12,0,0" Foreground="Gray" FontSize="12"/>
        <ui:Button Content="Probar impresora" Command="{Binding ProbarImpresoraCmd}" Margin="0,8,0,0" HorizontalAlignment="Left" Icon="{ui:SymbolIcon Print24}"/>
      </StackPanel>
    </ui:Card>
    <ui:Card Background="White" BorderBrush="#E5E5E5" BorderThickness="1" Padding="20">
      <StackPanel>
        <TextBlock Text="Usuarios (quién entra a la app)" FontSize="18" FontWeight="Bold" Foreground="Black"/>
        <DataGrid ItemsSource="{Binding Usuarios}" SelectedItem="{Binding Seleccionado, Mode=TwoWay}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" CanUserResizeRows="False"
                  IsReadOnly="True" SelectionMode="Single" MinHeight="90" Margin="0,12,0,0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
            <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="140"/>
            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90"/>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Nuevo usuario" FontWeight="Bold" Margin="0,16,0,0" Foreground="Black"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBox Text="{Binding NuevoNombre, UpdateSourceTrigger=PropertyChanged}" Width="180" Padding="8,6" FontSize="14" ToolTip="Nombre"/>
          <TextBox Text="{Binding NuevoUser, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="8,0,0,0" Padding="8,6" FontSize="14" ToolTip="usuario"/>
          <TextBox Text="{Binding NuevoClave, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="8,0,0,0" Padding="8,6" FontSize="14" ToolTip="clave (4+)"/>
          <ui:Button Content="Crear usuario" Command="{Binding CrearUsuarioCmd}" Appearance="Secondary" Margin="8,0,0,0" Icon="{ui:SymbolIcon Add24}"/>
        </StackPanel>
        <Border Background="#F3F3F3" CornerRadius="8" Padding="12" Margin="0,12,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="Edit24" Margin="0,0,8,0"/>
              <TextBlock Text="Modificar usuario y clave (lápiz)" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
              <ui:Button Content="Editar" Command="{Binding EditarCmd}" Margin="16,0,0,0" Icon="{ui:SymbolIcon Edit24}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Nombre" Foreground="Gray" FontSize="12"/>
                <TextBox Text="{Binding EditNombre, UpdateSourceTrigger=PropertyChanged}" Width="180" Padding="8,6" FontSize="14"/>
              </StackPanel>
              <StackPanel Margin="8,0,0,0">
                <TextBlock Text="Usuario" Foreground="Gray" FontSize="12"/>
                <TextBox Text="{Binding EditUser, UpdateSourceTrigger=PropertyChanged}" Width="140" Padding="8,6" FontSize="14"/>
              </StackPanel>
              <StackPanel Margin="8,0,0,0">
                <TextBlock Text="Nueva clave" Foreground="Gray" FontSize="12"/>
                <TextBox Text="{Binding NuevaClave, UpdateSourceTrigger=PropertyChanged}" Width="140" Padding="8,6" FontSize="14" ToolTip="Vacío = no cambiar"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <ui:Button Content="Guardar usuario" Command="{Binding GuardarUsuarioCmd}" Appearance="Secondary" Icon="{ui:SymbolIcon Save24}"/>
              <ui:Button Content="Cambiar clave" Command="{Binding ClaveCmd}" Margin="8,0,0,0"/>
              <ui:Button Content="Activar / Desactivar" Command="{Binding ToggleCmd}" Margin="8,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock Text="La tabla está bloqueada: selecciona una fila, dale al lápiz y edita aquí." Foreground="Gray" FontSize="11" Margin="0,8,0,0"/>
      </StackPanel>
    </ui:Card>
    <ui:Card Background="White" BorderBrush="#E5E5E5" BorderThickness="1" Padding="20" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Text="Lavadores (personal que lava)" FontSize="18" FontWeight="Bold" Foreground="Black"/>
        <DataGrid ItemsSource="{Binding Lavadores}" SelectedItem="{Binding LavadorSel, Mode=TwoWay}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" CanUserResizeRows="False"
                  IsReadOnly="True" SelectionMode="Single" MinHeight="90" Margin="0,12,0,0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90"/>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <TextBox Text="{Binding NuevoLavador, UpdateSourceTrigger=PropertyChanged}" Width="220" Padding="8,6" FontSize="14" ToolTip="Nombre del lavador"/>
          <ui:Button Content="Crear lavador" Command="{Binding CrearLavCmd}" Appearance="Secondary" Margin="8,0,0,0" Icon="{ui:SymbolIcon Add24}"/>
        </StackPanel>
        <Border Background="#F3F3F3" CornerRadius="8" Padding="12" Margin="0,12,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="Edit24" Margin="0,0,8,0"/>
              <TextBlock Text="Modificar lavador (lápiz)" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
              <ui:Button Content="Editar" Command="{Binding EditarLavCmd}" Margin="16,0,0,0" Icon="{ui:SymbolIcon Edit24}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <TextBox Text="{Binding EditLavador, UpdateSourceTrigger=PropertyChanged}" Width="220" Padding="8,6" FontSize="14" ToolTip="Nombre"/>
              <ui:Button Content="Guardar" Command="{Binding GuardarLavCmd}" Appearance="Secondary" Margin="8,0,0,0" Icon="{ui:SymbolIcon Save24}"/>
              <ui:Button Content="Activar / Desactivar" Command="{Binding ToggleLavCmd}" Margin="8,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ui:Card>
    <TextBlock Text="{Binding Mensaje}" Foreground="Green" Margin="4,8,0,0" FontSize="14"/>
  </StackPanel>
  </ScrollViewer>
</UserControl>
