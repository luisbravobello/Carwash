<UserControl x:Class="Carwash.Desktop.Views.CajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="#FAFBFC">
  <ScrollViewer Margin="24,8,24,24" VerticalScrollBarVisibility="Auto" Background="#FAFBFC">
    <StackPanel Background="#FAFBFC">
      <TextBlock Text="Caja" FontSize="26" FontWeight="Bold" Foreground="Black" Margin="0,0,0,16"/>
      <TextBlock Text="Cuadre del día" FontSize="16" FontWeight="Bold" Foreground="Black" Margin="0,0,0,0"/>
      <TextBlock Text="{Binding Error}" Foreground="Red" Margin="0,4,0,0"/>

      <UniformGrid Columns="3" Margin="0,16,0,0">
        <ui:Card Margin="0,0,8,8" Background="White">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="History24" FontSize="22" Margin="0,0,8,0"/>
              <TextBlock Text="TICKETS" Foreground="Gray" FontWeight="Bold"/>
            </StackPanel>
            <TextBlock Text="{Binding Tickets}" FontSize="36" FontWeight="Bold" Margin="0,8,0,0" Foreground="Black"/>
            <TextBlock Text="vendidos hoy" Foreground="Gray"/>
          </StackPanel>
        </ui:Card>
        <ui:Card Margin="0,0,8,8" Background="White">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Cart24" FontSize="22" Margin="0,0,8,0"/>
              <TextBlock Text="EFECTIVO" Foreground="Gray" FontWeight="Bold"/>
            </StackPanel>
            <TextBlock Text="{Binding Efectivo, StringFormat={}RD${0:N2}}" FontSize="28" FontWeight="Bold" Foreground="Green" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding PorcEfectivo, StringFormat={}{0:N0}% del total, Mode=OneWay}" Foreground="Gray"/>
          </StackPanel>
        </ui:Card>
        <ui:Card Margin="0,0,0,8" Background="White">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="ArrowSync24" FontSize="22" Margin="0,0,8,0"/>
              <TextBlock Text="TRANSFERENCIA" Foreground="Gray" FontWeight="Bold"/>
            </StackPanel>
            <TextBlock Text="{Binding Transferencia, StringFormat={}RD${0:N2}}" FontSize="28" FontWeight="Bold" Foreground="DodgerBlue" Margin="0,8,0,0"/>
            <TextBlock Text="sin punto, directo" Foreground="Gray"/>
          </StackPanel>
        </ui:Card>
      </UniformGrid>

      <ui:Card Margin="0,8,0,0" Background="White">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="TOTAL DEL DÍA" Foreground="Gray" FontWeight="Bold"/>
            <TextBlock Text="{Binding Total, StringFormat={}RD${0:N2}}" FontSize="42" FontWeight="Bold" Foreground="Black"/>
            <ProgressBar Value="{Binding PorcEfectivo, Mode=OneWay}" Maximum="100" Height="10" Margin="0,12,0,0" Foreground="#16A34A" Background="#E5E5E5"/>
            <TextBlock Text="Verde = % en efectivo" Foreground="Gray" FontSize="11" Margin="0,4,0,0"/>
          </StackPanel>
          <ui:SymbolIcon Grid.Column="1" Symbol="Box24" FontSize="64" Margin="24,0,8,0" Foreground="Black"/>
        </Grid>
      </ui:Card>
      <ui:Card Margin="0,8,0,0" Background="White">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:SymbolIcon Symbol="History24" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding PendientesTexto}" FontSize="14" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
        </StackPanel>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
