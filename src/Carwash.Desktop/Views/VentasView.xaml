<UserControl x:Class="Carwash.Desktop.Views.VentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="#FAFBFC">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FAFBFC">
  <StackPanel Margin="24,8,24,24" Background="#FAFBFC" MaxWidth="980" HorizontalAlignment="Left">
    <TextBlock Text="Nueva venta" FontSize="26" FontWeight="Bold" Foreground="Black" Margin="0,0,0,16"/>

    <ui:Card Margin="0,0,0,16" Background="White" BorderBrush="#E5E5E5" BorderThickness="1" Padding="20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="12" Background="#E8F1FD" Margin="0,0,10,0">
            <TextBlock Text="1" Foreground="#0F6CBD" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Cliente y vehículo" FontSize="16" FontWeight="Bold" Foreground="Black"/>
        </StackPanel>
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,8,0">
            <TextBlock Text="Nombre" Foreground="Gray" FontSize="12"/>
            <TextBox Text="{Binding ClienteNombre, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" Margin="0,4,0,0" ToolTip="¿A nombre de quién?"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Grid.Row="0" Margin="8,0,0,0">
            <TextBlock Text="Vehículo" Foreground="Gray" FontSize="12"/>
            <TextBox Text="{Binding VehiculoDescripcion, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" Margin="0,4,0,0" ToolTip="Ej: yipeta blanca"/>
          </StackPanel>
          <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <TextBlock Text="Lavador (quién lo lava)" Foreground="Gray" FontSize="12"/>
            <ComboBox ItemsSource="{Binding Lavadores}" SelectedItem="{Binding LavadorSel}" DisplayMemberPath="Nombre" Padding="8,6" FontSize="14" Margin="0,4,0,0"/>
            <TextBlock Text="¿No sale nadie? Crea el personal en Config → Lavadores." Foreground="#B45309" FontSize="12" Margin="0,4,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Lavadores.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ui:Card>

    <ui:Card Margin="0,0,0,16" Background="White" BorderBrush="#E5E5E5" BorderThickness="1" Padding="20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="12" Background="#E8F1FD" Margin="0,0,10,0">
            <TextBlock Text="2" Foreground="#0F6CBD" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Productos" FontSize="16" FontWeight="Bold" Foreground="Black"/>
        </StackPanel>
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="Producto" Foreground="Gray" FontSize="12"/>
            <ComboBox ItemsSource="{Binding Productos}" SelectedItem="{Binding Seleccionado}" DisplayMemberPath="Display" Padding="8,6" FontSize="14" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,8,0">
            <TextBlock Text="Cant." Foreground="Gray" FontSize="12"/>
            <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="14" Margin="0,4,0,0"/>
          </StackPanel>
          <Button Grid.Column="2" Command="{Binding Agregar}" Margin="0,22,0,0" Padding="18,9" Cursor="Hand" VerticalAlignment="Top"
                  Background="#1E88FF" BorderThickness="0" Foreground="White">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border Background="#1E88FF" CornerRadius="6" Padding="{TemplateBinding Padding}">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Add24" Margin="0,0,8,0" Foreground="White"/>
                    <TextBlock Text="Agregar" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </Grid>
        <DataGrid ItemsSource="{Binding Carrito}" SelectedItem="{Binding LineaSeleccionada, Mode=TwoWay}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" CanUserResizeRows="False"
                  IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="None" Background="White" BorderThickness="0" Margin="0,16,0,0" MinHeight="80">
          <DataGrid.ColumnHeaderStyle>
            <Style TargetType="DataGridColumnHeader">
              <Setter Property="Foreground" Value="Gray"/>
              <Setter Property="FontSize" Value="12"/>
              <Setter Property="FontWeight" Value="Normal"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0,0,0,1"/>
              <Setter Property="BorderBrush" Value="#E5E5E5"/>
              <Setter Property="Padding" Value="4,6"/>
            </Style>
          </DataGrid.ColumnHeaderStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*"/>
            <DataGridTextColumn Header="Cant" Binding="{Binding Cantidad}" Width="80"/>
            <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat={}RD\${0:N2}}" Width="130"/>
            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}RD\${0:N2}}" Width="130"/>
            <DataGridTemplateColumn Width="40">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="×" FontSize="14" Foreground="Gray" Background="Transparent" BorderThickness="0" Padding="4,0"
                          Command="{Binding DataContext.Quitar, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" ToolTip="Quitar"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </ui:Card>

    <ui:Card Background="White" BorderBrush="#E5E5E5" BorderThickness="1" Padding="20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="12" Background="#E8F1FD" Margin="0,0,10,0">
            <TextBlock Text="3" Foreground="#0F6CBD" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Cobrar" FontSize="16" FontWeight="Bold" Foreground="Black"/>
        </StackPanel>
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="Método" Foreground="Gray" FontSize="12"/>
            <ComboBox SelectedValue="{Binding MetodoPagoId}" SelectedValuePath="Tag" Padding="8,6" FontSize="14" Margin="0,4,0,0">
              <ComboBoxItem Content="Efectivo" Tag="1" IsSelected="True"/>
              <ComboBoxItem Content="Transferencia" Tag="2"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="Recibido" Foreground="Gray" FontSize="12"/>
            <TextBox Text="{Binding MontoRecibido, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" Margin="0,4,0,0" ToolTip="RD$0,00"/>
          </StackPanel>
        </Grid>
        <Border CornerRadius="8" Padding="12,8" Margin="0,12,0,0" HorizontalAlignment="Left">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="#F3F3F3"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding CambioOk}" Value="True">
                  <Setter Property="Background" Value="#16A34A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CambioFalta}" Value="True">
                  <Setter Property="Background" Value="#EA8600"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding CambioTexto}" FontSize="16" FontWeight="Bold">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="Gray"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CambioOk}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding CambioFalta}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Border>
        <CheckBox Content="Dejar pendiente (paga al retirar el vehículo)" IsChecked="{Binding EsPendiente}" FontSize="14" Margin="0,10,0,0"/>
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="Total a cobrar" Foreground="Gray" FontSize="12"/>
            <TextBlock Text="{Binding Total, StringFormat={}RD\${0:N2}}" FontSize="32" FontWeight="Bold" Foreground="Black"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <ui:Button Content="Limpiar" Command="{Binding Limpiar}" Padding="20,10" Background="White" Foreground="Black"/>
            <Button Command="{Binding Cobrar}" Margin="10,0,0,0" Padding="22,10" Cursor="Hand"
                    Background="#1E88FF" BorderThickness="0" Foreground="White">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="#1E88FF" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <ui:SymbolIcon Symbol="Print24" Margin="0,0,8,0" Foreground="White"/>
                      <TextBlock Text="Cobrar e imprimir" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ui:Card>
    <TextBlock Text="{Binding Mensaje}" Foreground="Green" FontSize="14" Margin="4,10,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  </ScrollViewer>
</UserControl>
