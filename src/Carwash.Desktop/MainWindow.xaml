<ui:FluentWindow x:Class="Carwash.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Carwash.Desktop.ViewModels"
        xmlns:views="clr-namespace:Carwash.Desktop.Views"
        Title="Mi Carwash - Punto de Venta" Height="760" Width="1180" WindowStartupLocation="CenterScreen"
        Background="White" Foreground="Black">
  <Grid Background="White">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <ui:TitleBar Title="Mi Carwash Punta Cana" Grid.Row="0"/>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" BorderBrush="#E5E5E5" BorderThickness="0,0,1,0" Padding="14">
        <Border.Resources>
          <BooleanToVisibilityConverter x:Key="BoolVis"/>
        </Border.Resources>
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="2,2,0,18" VerticalAlignment="Center">
            <Border Width="32" Height="32" CornerRadius="8" Background="#1E88FF" Margin="0,0,10,0" Padding="7">
              <Path Data="M16 2 C16 2 7 13 7 20 a9 9 0 0 0 18 0 C25 20 16 2 16 2 Z" Fill="White" Stretch="Uniform"/>
            </Border>
            <TextBlock Text="Mi Carwash" Foreground="Black" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#1E88FF" CornerRadius="2" Visibility="{Binding IsVentas, Converter={StaticResource BoolVis}}"/>
            <Border Grid.Column="1" Margin="5,0,0,0" CornerRadius="8">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="Transparent"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVentas}" Value="True">
                      <Setter Property="Background" Value="#2D2D2D"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Button Click="GoVentas" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="12,9">
                <Button.Style>
                  <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#444444"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsVentas}" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Cart24" Margin="0,0,10,0"/>
                        <TextBlock Text="Ventas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Border>
          </Grid>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#1E88FF" CornerRadius="2" Visibility="{Binding IsProductos, Converter={StaticResource BoolVis}}"/>
            <Border Grid.Column="1" Margin="5,0,0,0" CornerRadius="8">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="Transparent"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsProductos}" Value="True">
                      <Setter Property="Background" Value="#2D2D2D"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Button Click="GoProductos" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="12,9">
                <Button.Style>
                  <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#444444"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsProductos}" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Box24" Margin="0,0,10,0"/>
                        <TextBlock Text="Productos" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Border>
          </Grid>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#1E88FF" CornerRadius="2" Visibility="{Binding IsHistorial, Converter={StaticResource BoolVis}}"/>
            <Border Grid.Column="1" Margin="5,0,0,0" CornerRadius="8">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="Transparent"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsHistorial}" Value="True">
                      <Setter Property="Background" Value="#2D2D2D"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Button Click="GoHistorial" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="12,9">
                <Button.Style>
                  <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#444444"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsHistorial}" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="History24" Margin="0,0,10,0"/>
                        <TextBlock Text="Historial" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Border>
          </Grid>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#1E88FF" CornerRadius="2" Visibility="{Binding IsCaja, Converter={StaticResource BoolVis}}"/>
            <Border Grid.Column="1" Margin="5,0,0,0" CornerRadius="8">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="Transparent"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCaja}" Value="True">
                      <Setter Property="Background" Value="#2D2D2D"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Button Click="GoCaja" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="12,9">
                <Button.Style>
                  <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#444444"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCaja}" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Money24" Margin="0,0,10,0"/>
                        <TextBlock Text="Caja" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Border>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#1E88FF" CornerRadius="2" Visibility="{Binding IsConfig, Converter={StaticResource BoolVis}}"/>
            <Border Grid.Column="1" Margin="5,0,0,0" CornerRadius="8">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="Transparent"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConfig}" Value="True">
                      <Setter Property="Background" Value="#2D2D2D"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Button Click="GoConfig" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="12,9">
                <Button.Style>
                  <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#444444"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsConfig}" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Settings24" Margin="0,0,10,0"/>
                        <TextBlock Text="Config" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Border>
          </Grid>
        </StackPanel>
          <Border DockPanel.Dock="Bottom" Background="Transparent" Padding="4,14,4,0" Margin="0,8,0,0" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="22" Background="#1E88FF" Margin="0,0,12,0">
                  <TextBlock Text="{Binding Iniciales}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding UsuarioNombre}" Foreground="Black" FontSize="14" FontWeight="Bold"/>
                  <TextBlock Text="{Binding UsuarioRol}" Foreground="#B45309" FontSize="11" FontWeight="Bold"/>
                  <TextBlock Text="{Binding UsuarioCuenta}" Foreground="Gray" FontSize="11"/>
                </StackPanel>
              </StackPanel>
              <Button Click="CerrarSesion" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,10,4,4" Foreground="#444444">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowRight24" Margin="0,0,10,0"/>
                        <TextBlock Text="Cerrar Sesión" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </StackPanel>
          </Border>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="0,0,0,0" Background="#FAFBFC">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,16,0,2" VerticalAlignment="Center">
          <ui:Button Content="Inicio" Click="GoInicio" Appearance="Secondary" Padding="8,2" FontSize="12" Background="Transparent" BorderThickness="0" Foreground="Gray"/>
          <TextBlock Text="›" Foreground="Gray" Margin="8,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Seccion}" FontWeight="SemiBold" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
        </StackPanel>
      <ContentControl Grid.Row="1" Content="{Binding Current}">
        <ContentControl.Resources>
          <DataTemplate DataType="{x:Type vm:MainViewModel}"><views:VentasView/></DataTemplate>
          <DataTemplate DataType="{x:Type vm:ProductosViewModel}"><views:ProductosView/></DataTemplate>
          <DataTemplate DataType="{x:Type vm:HistorialViewModel}"><views:HistorialView/></DataTemplate>
          <DataTemplate DataType="{x:Type vm:CajaViewModel}"><views:CajaView/></DataTemplate>
          <DataTemplate DataType="{x:Type vm:ConfigViewModel}"><views:ConfigView/></DataTemplate>
        </ContentControl.Resources>
      </ContentControl>
      </Grid>
    </Grid>
  </Grid>
</ui:FluentWindow>
