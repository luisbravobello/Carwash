<ui:FluentWindow x:Class="Carwash.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Mi Carwash" Height="540" Width="860" WindowStartupLocation="CenterScreen"
        Background="White">
  <Grid Background="White">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#111111" Padding="36">
      <Canvas>
        <Ellipse Canvas.Left="-90" Canvas.Top="-90" Width="260" Height="260" Fill="#FFFFFF" Opacity="0.05"/>
        <Ellipse Canvas.Left="60" Canvas.Top="180" Width="110" Height="110" Fill="#FFFFFF" Opacity="0.05"/>
        <Ellipse Canvas.Left="230" Canvas.Top="330" Width="190" Height="190" Fill="#FFFFFF" Opacity="0.04"/>
        <Ellipse Canvas.Left="120" Canvas.Top="140" Width="8" Height="8" Fill="#FFFFFF" Opacity="0.4"/>
        <Ellipse Canvas.Left="200" Canvas.Top="110" Width="7" Height="7" Fill="#FFFFFF" Opacity="0.35"/>
        <Ellipse Canvas.Left="235" Canvas.Top="135" Width="5" Height="5" Fill="#FFFFFF" Opacity="0.3"/>
        <Ellipse Canvas.Left="90" Canvas.Top="230" Width="7" Height="7" Fill="#FFFFFF" Opacity="0.3"/>
        <Ellipse Canvas.Left="170" Canvas.Top="225" Width="5" Height="5" Fill="#FFFFFF" Opacity="0.35"/>
        <Ellipse Canvas.Left="195" Canvas.Top="215" Width="10" Height="10" Fill="#FFFFFF" Opacity="0.25"/>
      </Canvas>
    </Border>

    <StackPanel Grid.Column="1" Margin="56,40" VerticalAlignment="Center" Background="White">
      <TextBlock Text="Inicia sesión" FontSize="24" FontWeight="Bold" Foreground="Black"/>
      <TextBlock Text="Ingresa tus datos de acceso para entrar al sistema."
                 Foreground="Gray" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,24"/>
      <TextBlock Text="Usuario" Foreground="Black" FontSize="13" FontWeight="SemiBold"/>
      <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,6,0,14" Padding="12,0" Background="White">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <ui:SymbolIcon Grid.Column="0" Symbol="Person24" Foreground="#999999" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Grid Grid.Column="1">
            <TextBlock Text="nombre.apellido" Foreground="#AAAAAA" FontSize="14" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=UserBox}" Value="">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBox x:Name="UserBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     BorderThickness="0" Background="Transparent" Padding="0,10" FontSize="14"/>
          </Grid>
        </Grid>
      </Border>
      <TextBlock Text="Contraseña" Foreground="Black" FontSize="13" FontWeight="SemiBold"/>
      <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,6,0,12" Padding="12,0" Background="White">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <ui:SymbolIcon Grid.Column="0" Symbol="LockClosed24" Foreground="#999999" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Grid Grid.Column="1">
            <TextBlock x:Name="PassMark" Text="••••••••" Foreground="#AAAAAA" FontSize="14" VerticalAlignment="Center"/>
            <PasswordBox x:Name="Pass" BorderThickness="0" Background="Transparent" Padding="0,10" FontSize="14"
                         KeyDown="Pass_KeyDown" PasswordChanged="Pass_Changed"/>
          </Grid>
        </Grid>
      </Border>
      <CheckBox Content="Recordarme" IsChecked="{Binding Recordarme}" FontSize="13" Margin="0,0,0,20"/>
      <Button Content="Entrar" Click="DoEntrar" FontSize="15" FontWeight="Bold" Foreground="White"
              BorderThickness="0" Padding="12" Cursor="Hand">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border Background="#111111" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <TextBlock Text="Entrar" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Button.Template>
      </Button>
      <TextBlock Text="{Binding Mensaje}" Foreground="Green" Margin="0,12,0,0" TextWrapping="Wrap" HorizontalAlignment="Center" FontSize="13"/>
    </StackPanel>
    <Button Grid.ColumnSpan="2" Content="✕" Click="CerrarApp" HorizontalAlignment="Right" VerticalAlignment="Top"
            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="14,10"
            Foreground="Black" FontSize="16" FontWeight="Bold" Panel.ZIndex="10" ToolTip="Cerrar"/>
  </Grid>
</ui:FluentWindow>
